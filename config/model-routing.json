{
  "schema_version": 1,
  "verified_at": "2026-11-25",
  "claude_code_version": "2.1.331",
  "environment_note": "Identifiers from Claude Code client cache on Arnab's machine (claude_pro). Re-run tools/model_verify.py after upgrades.",
  "models": {
    "production": {
      "role": "Primary production and engineering",
      "id": "claude-sonnet-5-5",
      "input_price_usd_per_mtok": 2,
      "aliases": ["sonnet", "claude-sonnet-5"],
      "long_context_id": "claude-sonnet-5-5[1m]",
      "default_effort": "medium",
      "cli_select": "--model claude-sonnet-5-5"
    },
    "creative": {
      "role": "Creative direction, architecture, final visual QA",
      "id": "claude-opus-5-5",
      "input_price_usd_per_mtok": 4,
      "aliases": ["opus"],
      "default_effort": "high",
      "cli_select": "--model claude-opus-5-5"
    },
    "worker": {
      "role": "Last resort of the boilerplate delegation chain only",
      "id": "claude-haiku-5-5",
      "input_price_usd_per_mtok": 0.1,
      "aliases": ["haiku"],
      "default_effort": "low",
      "cli_select": "--model claude-haiku-5-5",
      "cannot_approve": [
        "creative_decisions",
        "final_cuts",
        "storyboard",
        "visual_quality",
        "audio_quality_gate",
        "completed_video"
      ]
    },
    "escalation": {
      "role": "Exceptional long-horizon or architectural uncertainty only",
      "id": "claude-fable-5-2[1m]",
      "input_price_usd_per_mtok": 8,
      "aliases": ["fable"],
      "default_effort": "high",
      "cli_select": "--model claude-fable-5-2[1m]",
      "use_when": [
        "multi_system_redesign",
        "exhausted_opus_escalation",
        "explicit_user_request"
      ]
    }
  },
  "session_default": { "model": "production", "settings_file": ".claude/settings.json" },
  "cost": {
    "note": "Comparison weights, as multiples of each model's input price; not a bill. Input prices: platform.claude.com pricing, read 2026-11-26. List cache-read rates differ by model (0.05x Sonnet/Opus 5.5, 0.025x Fable 5.2) and Haiku 5.5 costs more above 100k-token prompts.",
    "weights": { "input": 1, "cache_write": 1.25, "cache_read": 0.1, "output": 5 }
  },
  "effort_levels": {
    "supported": true,
    "cli_flag": "--effort",
    "values": ["low", "medium", "high"],
    "default_by_task_class": {
      "mechanical_classification": { "model": "worker", "effort": "low" },
      "routine_implementation": { "model": "production", "effort": "medium" },
      "routine_debugging": { "model": "production", "effort": "medium" },
      "complex_remotion": { "model": "production", "effort": "high" },
      "research_synthesis": { "model": "production", "effort": "high" },
      "scriptwriting": { "model": "production", "effort": "high" },
      "creative_direction": { "model": "creative", "effort": "high" },
      "complex_architecture": { "model": "creative", "effort": "high" },
      "difficult_debugging": { "model": "creative", "effort": "high" },
      "final_visual_qa": { "model": "creative", "effort": "high" },
      "log_summarization": { "model": "worker", "effort": "low", "prefer_script": true }
    }
  },
  "checkpoints": {
    "compose_start": { "model": "creative", "task": "creative_direction" },
    "compose_stills": { "model": "creative", "task": "approval_stills_review" },
    "deliver_final_qa": { "model": "creative", "task": "final_visual_qa" }
  },
  "subagents": {
    "vision_qa": { "model": "creative", "same_as_main": false, "agent": "vision-qa" },
    "creative_director": { "model": "creative", "agent": "creative-director" },
    "restate_test": { "model": "worker", "note": "cheapest vision-capable; never passes QA" },
    "heavy_job_runner": { "type": "script", "script": "tools/jobs/batch.sh", "no_setting_changes": true }
  }
}